rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - role: string (admin|user)
    //   - createdAt: timestamp
    //
    // Collection: theologyProgress
    // Document ID: {progressId}
    // Fields:
    //   - userId: string (required)
    //   - courseId: string (required)
    //   - completedLessons: list
    //   - lastAccessed: timestamp
    //
    // Collection: careerProgress
    // Document ID: {careerId}
    // Fields:
    //   - userId: string (required)
    //   - points: int
    //   - patent: string
    //   - history: list
    //
    // Collection: notes
    // Document ID: {noteId}
    // Fields:
    //   - userId: string (required)
    //   - title: string (required)
    //   - content: string (required)
    //   - category: string
    //   - createdAt: string|timestamp
    //   - updatedAt: string|timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "missoeselroi@gmail.com" && request.auth.token.email_verified == true ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
             data.id is string &&
             data.email is string &&
             data.role in ['admin', 'user'];
    }

    function isValidNote(data) {
      return data.keys().hasAll(['userId', 'title', 'content']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() < 500 &&
             data.content is string && data.content.size() < 50000;
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'user' || (request.auth.token.email == "missoeselroi@gmail.com" && request.auth.token.email_verified == true));
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /theologyProgress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /careerProgress/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidNote(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidNote(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /theologyCertificates/{certId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /metrics/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
