{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "joinDate": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "diaryPassword": { "type": "string" },
        "panoramaMedals": {
          "type": "object",
          "properties": {
            "bronze": { "type": "integer" },
            "silver": { "type": "integer" },
            "gold": { "type": "integer" },
            "trophy": { "type": "integer" }
          }
        },
        "favorites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verse": { "type": "string" },
              "reference": { "type": "string" },
              "date": { "type": "string", "format": "date-time" }
            }
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "theme": { "type": "string", "enum": ["light", "dark", "system"] },
            "preferredBible": { "type": "string" },
            "fontSize": { "type": "string" }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "accesses": { "type": "integer" },
            "totalTime": { "type": "integer" },
            "totalStudies": { "type": "integer" },
            "forumParticipations": { "type": "integer" },
            "shares": { "type": "integer" },
            "hasContributed": { "type": "boolean" },
            "membershipMonths": { "type": "integer" }
          }
        }
      },
      "required": ["id", "email", "role"]
    },
    "TheologyProgress": {
      "title": "Theology Progress",
      "description": "Tracks user progress in theology courses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "lastAccessed": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId"]
    },
    "CareerProgress": {
      "title": "Career Progress",
      "description": "Tracks user career patents and points",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "points": { "type": "integer" },
        "patent": { "type": "string" },
        "history": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["userId", "points", "patent"]
    },
    "Note": {
      "title": "Note",
      "description": "User notebook entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content"]
    },
    "TheologyCertificate": {
      "title": "Theology Certificate",
      "description": "User theology course certificates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "date": { "type": "string" },
        "issuedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "subject", "date"]
    },
    "AudioTrack": {
      "title": "Audio Track",
      "description": "User generated audio tracks and narrations",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "audioUrl": { "type": "string" },
        "subject": { "type": "string" },
        "text": { "type": "string" },
        "style": { "type": "string" },
        "emotion": { "type": "string" },
        "size": { "type": "number" },
        "duration": { "type": "number" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "audioUrl"]
    },
    "TheologySummary": {
      "title": "Theology Summary",
      "description": "User generated theology subject summaries with AI feedback",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "score": { "type": "number" },
        "aiFeedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "type", "content", "score"]
    },
    "TheologyTermsAcceptance": {
      "title": "Theology Terms Acceptance",
      "description": "Records user acceptance of theology course terms",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "acceptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "acceptedAt"]
    },
    "AudioCollection": {
      "title": "Audio Collection",
      "description": "User generated audio search results and theology content",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "audioUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["userId", "title", "text", "audioUrl"]
    },
    "Metrics": {
      "title": "Metrics",
      "description": "User usage metrics and time tracking",
      "type": "object",
      "properties": {
        "accesses": { "type": "integer" },
        "totalTime": { "type": "integer" },
        "forumParticipations": { "type": "integer" },
        "shares": { "type": "integer" },
        "hasContributed": { "type": "boolean" },
        "membershipMonths": { "type": "integer" },
        "sectionTimes": { 
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "BibleRaceProgress": {
      "title": "Bible Race Progress",
      "description": "Tracks user progress, points and streaks in the Bible Race",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "currentBook": { "type": "string" },
        "currentChapter": { "type": "integer" },
        "points": { "type": "integer" },
        "monthlyPoints": { "type": "integer" },
        "annualPoints": { "type": "integer" },
        "dailyReadCount": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "lastReadDate": { "type": "string", "format": "date-time" },
        "medals": { "type": "array", "items": { "type": "string" } },
        "finishedBooksCount": { "type": "integer" },
        "publicMessage": { "type": "string" },
        "userJoinDate": { "type": "string", "format": "date-time" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "currentBook", "currentChapter", "points"]
    },
    "BibleRaceMessage": {
      "title": "Bible Race Message",
      "description": "Messages sent between users in the Bible Race",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "fromUserName": { "type": "string" },
        "toUserId": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUserId", "toUserId", "message", "createdAt"]
    },
    "BibleRaceChampion": {
      "title": "Bible Race Champion",
      "description": "Historical champions of the Bible Race",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "points": { "type": "integer" },
        "period": { "type": "string" },
        "type": { "type": "string", "enum": ["monthly", "annual", "overall"] },
        "wonAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "points", "type", "wonAt"]
    },
    "PersonalDiaryEntry": {
      "title": "Personal Diary Entry",
      "description": "User personal diary entries",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "createdAt"]
    },
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "User personal journal entries with Bible verses and reflections",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "verseReference": { "type": "string" },
        "topic": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "createdAt"]
    },
    "CreditData": {
      "title": "Credit Data",
      "description": "User AI credit balance",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "integer" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance"]
    },
    "CreditTransaction": {
      "title": "Credit Transaction",
      "description": "Record of credit consumption or purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["consumption", "purchase"] },
        "amount": { "type": "integer" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "description", "date"]
    },
    "EvangelismProgress": {
      "title": "Evangelism Progress",
      "description": "Tracks user progress in evangelism courses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "enrolled": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "EvangelismTermsAcceptance": {
      "title": "Evangelism Terms Acceptance",
      "description": "Records user acceptance of evangelism course terms",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "acceptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "acceptedAt"]
    },
    "SharedEvangelismMaterial": {
      "title": "Shared Evangelism Material",
      "description": "AI generated evangelism course content",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "subject": { "type": "string" },
        "chapter": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "subject", "chapter"]
    },
    "QuizLeaderboard": {
      "title": "Quiz Leaderboard",
      "description": "User scores and rankings for the Bible Quiz",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "score": { "type": "integer" },
        "battlesWon": { "type": "integer" },
        "panoramaScore": { "type": "integer" },
        "panoramaTime": { "type": "integer" },
        "panoramaSavedBookIndex": { "type": "integer" },
        "whoAmIScore": { "type": "integer" },
        "timelineScore": { "type": "integer" },
        "crosswordScore": { "type": "integer" },
        "hangmanScore": { "type": "integer" },
        "wordSearchScore": { "type": "integer" },
        "cryptogramScore": { "type": "integer" },
        "anagramScore": { "type": "integer" },
        "hiddenWordScore": { "type": "integer" },
        "totalScore": { "type": "integer" },
        "credits": { "type": "integer" },
        "panoramaMedals": {
          "type": "object",
          "properties": {
            "bronze": { "type": "integer" },
            "silver": { "type": "integer" },
            "gold": { "type": "integer" },
            "trophy": { "type": "integer" }
          }
        },
        "lastScore": { "type": "integer" },
        "trend": { "type": "string", "enum": ["up", "down", "same"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "score", "updatedAt"]
    },
    "Study": {
      "title": "Study",
      "description": "User saved Bible studies and AI commentaries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "verseReference": { "type": "string" },
        "bibleVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "createdAt"]
    },
    "BibleAnnotation": {
      "title": "Bible Annotation",
      "description": "User bible verse annotations including highlights and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "verseId": { "type": "string" },
        "type": { "type": "string", "enum": ["highlight", "underline", "circle", "none"] },
        "color": { "type": "string" },
        "note": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "verseId", "type", "color", "isFavorite", "updatedAt"]
    },
    "StorytellingProgress": {
      "title": "Storytelling Progress",
      "description": "Tracks user progress in storytelling courses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" },
        "sectionMetrics": { "type": "object", "additionalProperties": { "type": "integer" } }
      },
      "required": ["userId"]
    },
    "StorytellingTermsAcceptance": {
      "title": "Storytelling Terms Acceptance",
      "description": "Records user acceptance of storytelling course terms",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "acceptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "acceptedAt"]
    },
    "SharedStorytellingMaterial": {
      "title": "Shared Storytelling Material",
      "description": "AI generated storytelling course content",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "subject": { "type": "string" },
        "chapter": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "subject", "chapter"]
    },
    "QuizRoom": {
      "title": "Quiz Room",
      "description": "Multiplayer quiz battle room",
      "type": "object",
      "properties": {
        "players": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "enum": ["waiting", "started", "finished"] },
        "questions": { "type": "array", "items": { "type": "object" } },
        "winners": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "BibleReadingPlan": {
      "title": "Bible Reading Plan",
      "description": "User personalized Bible reading plans and progress",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "planType": { "type": "string", "enum": ["chronological", "thematic", "testament"] },
        "startDate": { "type": "string", "format": "date-time" },
        "completedDays": { "type": "array", "items": { "type": "integer" } },
        "remindersEnabled": { "type": "boolean" },
        "reminderTime": { "type": "string" },
        "currentDay": { "type": "integer" }
      },
      "required": ["userId", "planType", "startDate"]
    },
    "QuizCup": {
      "title": "Quiz Cup",
      "description": "Tournament style quiz competition",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string" },
        "maxPlayers": { "type": "integer" },
        "players": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "enum": ["waiting", "playing", "finished"] },
        "currentRound": { "type": "integer" },
        "rounds": { "type": "array", "items": { "type": "object" } },
        "winnerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PrayerRequest": {
      "title": "Prayer Request",
      "description": "User shared prayer requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "prayerCount": { "type": "integer" },
        "prayingUserIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "content", "createdAt"]
    },
    "PrayerComment": {
      "title": "Prayer Comment",
      "description": "Comments on prayer requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "userId", "userName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/theologyProgress/{progressId}": {
      "schema": "TheologyProgress",
      "description": "Theology progress records"
    },
    "/careerProgress/{careerId}": {
      "schema": "CareerProgress",
      "description": "Career progress records"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "User notes"
    },
    "/theologyCertificates/{certId}": {
      "schema": "TheologyCertificate",
      "description": "Theology certificates"
    },
    "/audio_box/{trackId}": {
      "schema": "AudioTrack",
      "description": "User audio tracks"
    },
    "/metrics/{userId}": {
      "schema": "Metrics",
      "description": "User metrics"
    },
    "/theologySummaries/{summaryId}": {
      "schema": "TheologySummary",
      "description": "Theology subject summaries"
    },
    "/theologyTermsAcceptance/{userId}": {
      "schema": "TheologyTermsAcceptance",
      "description": "User theology terms acceptance records"
    },
    "/audioCollection/{audioId}": {
      "schema": "AudioCollection",
      "description": "User audio collection"
    },
    "/bibleRaceProgress/{userId}": {
      "schema": "BibleRaceProgress",
      "description": "User Bible Race progress and scores"
    },
    "/bibleRaceMessages/{messageId}": {
      "schema": "BibleRaceMessage",
      "description": "Bible Race user messages"
    },
    "/bibleRaceChampions/{championId}": {
      "schema": "BibleRaceChampion",
      "description": "Historical Bible Race champions"
    },
    "/personalDiaryEntries/{entryId}": {
      "schema": "PersonalDiaryEntry",
      "description": "User personal diary entries"
    },
    "/journalEntries/{entryId}": {
      "schema": "JournalEntry",
      "description": "User journal entries"
    },
    "/userCredits/{userId}": {
      "schema": "CreditData",
      "description": "User AI credit balance"
    },
    "/creditTransactions/{transactionId}": {
      "schema": "CreditTransaction",
      "description": "User credit transaction history"
    },
    "/evangelismProgress/{userId}": {
      "schema": "EvangelismProgress",
      "description": "User evangelism progress"
    },
    "/evangelismTermsAcceptance/{userId}": {
      "schema": "EvangelismTermsAcceptance",
      "description": "User evangelism terms acceptance"
    },
    "/shared_evangelism_materials/{materialId}": {
      "schema": "SharedEvangelismMaterial",
      "description": "Shared evangelism course materials"
    },
    "/quizLeaderboard/{userId}": {
      "schema": "QuizLeaderboard",
      "description": "User Bible Quiz rankings"
    },
    "/studies/{studyId}": {
      "schema": "Study",
      "description": "User saved Bible studies"
    },
    "/bibleAnnotations/{annotationId}": {
      "schema": "BibleAnnotation",
      "description": "User bible verse annotations"
    },
    "/storytellingProgress/{userId}": {
      "schema": "StorytellingProgress",
      "description": "User storytelling progress"
    },
    "/storytellingTermsAcceptance/{userId}": {
      "schema": "StorytellingTermsAcceptance",
      "description": "User storytelling terms acceptance"
    },
    "/shared_storytelling_materials/{materialId}": {
      "schema": "SharedStorytellingMaterial",
      "description": "Shared storytelling course materials"
    },
    "/quizRooms/{roomId}": {
      "schema": "QuizRoom",
      "description": "Quiz battle rooms"
    },
    "/quizCups/{cupId}": {
      "schema": "QuizCup",
      "description": "Quiz tournament cups"
    },
    "/readingPlans/{planId}": {
      "schema": "BibleReadingPlan",
      "description": "User Bible reading plans"
    },
    "/prayerRequests/{requestId}": {
      "schema": "PrayerRequest",
      "description": "Public prayer requests"
    },
    "/prayerRequests/{requestId}/comments/{commentId}": {
      "schema": "PrayerComment",
      "description": "Comments on specific prayer requests"
    }
  }
}
